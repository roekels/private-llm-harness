# Optional, for development and the CLI examples only.
# The app reads keys from the macOS Keychain by default. A profile can instead
# use env:NAME, which reads NAME from the environment, then from a .env file in
# ~/Library/Application Support/com.dewit.qwen35-harness/.env
# Copy this file to that folder as .env and fill in your own key. Never commit it.
LLM_API_KEY=
