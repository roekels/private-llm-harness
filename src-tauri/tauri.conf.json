{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ruan's Harness",
  "version": "0.8.1",
  "identifier": "com.dewit.qwen35-harness",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ruan's Harness",
        "width": 1200,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Sandboxed agent harness for a self-hosted LLM",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDMkRDRTJEMjYyQzA5OEIKUldTTENTd21MYzR0L0FJa0dtK0piYWtjTVlwR2I0UnZubUoyczFkMUMvV1ZWR2Z2cjJZVzRqdWoK",
      "endpoints": [
        "https://github.com/roekels/private-llm-harness/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
